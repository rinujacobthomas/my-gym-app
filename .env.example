# openGym platform — copy to .env and fill in.
# Root config used by docker-compose + all apps (Vite reads VITE_* at build time).

# ---- core ----
PUBLIC_APP_URL=http://localhost:8080     # https://gym.example.com in prod (required for OAuth cookies)
PORT=3000
WEB_PORT=8080

# ---- database ----
POSTGRES_USER=opengym
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=opengym
DATABASE_URL=postgresql://opengym:change-me-now@postgres:5432/opengym

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
# Authorized redirect URI: {PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@gmail.com               # comma-separated; auto-ACTIVE ADMIN accounts

# ---- Razorpay (https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- misc ----
CORS_ORIGINS=                            # extra origins if frontends deploy off-origin
VAPID_SUBJECT=mailto:admin@gym.example.com
